# EJEMPLO con valores FALSOS. No pongas datos reales aquí.
# El archivo real (.env) lo crea scripts/setup-secrets.sh en el servidor, con permisos 600.

# Dominio donde se publica la app (debe apuntar a la IP del VPS)
DOMAIN='pedidos.ejemplo.com'
# Correo para los avisos de Let's Encrypt (certificado HTTPS)
ACME_EMAIL='correo@ejemplo.com'

# Generados automáticamente por el script (se usarán en las fases 2 y 3)
SESSION_SECRET='valor-falso-generado-por-el-script'
MYSQL_PASSWORD='valor-falso-generado-por-el-script'

# Conexión a la base de datos (MariaDB). NUNCA uses el usuario root aquí.
# En Easypanel, DB_HOST es el nombre interno del servicio de la base (no la IP pública).
DB_HOST='2.24.107.223'
DB_PORT='3306'
DB_USER='root'
DB_PASSWORD='adminpostgres'
DB_NAME='fruver_lya'
# "si" cifra la conexión con TLS (solo si el servidor de la base lo tiene activado).
DB_SSL='no'

# TEMPORAL (fase 2): "si" activa los usuarios sintéticos del login en el VPS.
# Sus contraseñas son públicas (README): déjalo en "no" cuando termines de probar.
USUARIOS_PRUEBA='no'
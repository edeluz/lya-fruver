{
  "name": "lya-fruver",
  "version": "1.0.0",
  "private": true,
  "description": "L&A Fruver: pedidos, catálogo, facturación y reportes.",
  "main": "server/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/copy-vendor.js && node scripts/build-info.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "bootstrap": "5.3.9",
    "bootstrap-icons": "1.13.2",
    "chart.js": "4.6.1",
    "html2canvas": "1.4.1",
    "jquery": "4.0.0",
    "puppeteer-core": "25.16.0",
    "sharp": "0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
